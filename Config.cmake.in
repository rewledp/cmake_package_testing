@PACKAGE_INIT@

set(_NAME "my_cmake_project")

set(_SUM_NUMBER_COMPONENT "sum_numbers_export.cmake")
set(_FUCK_SHEEP_COMPONENT "fuck_sheep_export.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/${_SUM_NUMBER_COMPONENT}")

if(NOT ${_NAME}_FIND_COMPONENTS)
	include("${CMAKE_CURRENT_LIST_DIR}/${_SUM_NUMBER_COMPONENT}")
	set(${_NAME}_sum_numbers_FOUND TRUE)
else()
	foreach(_comp ${${_NAME}_FIND_COMPONENTS})
		if (_comp STREQUAL "sum_numbers")
			include("${CMAKE_CURRENT_LIST_DIR}/${_SUM_NUMBER_COMPONENT}")
			set(${_NAME}_${_comp}_FOUND TRUE)
		elseif(_comp STREQUAL "fuck_sheep")
			include("${CMAKE_CURRENT_LIST_DIR}/${_FUCK_SHEEP_COMPONENT}")
			set(${_NAME}_${_comp}_FOUND TRUE)
		else()
			set(${_NAME}_${_comp}_FOUND FALSE)
			# set(${_NAME}_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
		endif()
	endforeach()
endif()

check_required_components(${_NAME})
